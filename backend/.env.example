# ==============================================================================
# VESTIGE BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env or configure in your deployment provider (Render / Railway).
# NEVER commit real production credentials or secrets to version control.
# ==============================================================================

# Server Port
PORT=8080

# Spring Active Profile: dev | prod | test
SPRING_PROFILES_ACTIVE=dev

# Required for production. Use a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-production-secret
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (Option B Security Strategy)
# Connects as the dedicated, least-privilege 'vestige_app' role.
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres?sslmode=require
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=require

# Dedicated application role credentials
DB_USERNAME=vestige_app
DB_PASSWORD=your_secure_db_password_here
# Connection pool sizing
DB_POOL_MAX=10
DB_POOL_MIN=2

# JPA DDL Validation (Keep as 'none' or 'validate' — schema managed via migrations)
JPA_DDL_AUTO=none

# ------------------------------------------------------------------------------
# Supabase Integration (Service-Role Key for Storage Buckets)
# Used exclusively server-side to access the private 'vendor-verification-documents' bucket.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://qiylcwurlhyhzhachoyb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_JWKS_URL=https://qiylcwurlhyhzhachoyb.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Server-side Orders & Webhook Verification)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
