*.mjs
!scripts/smoke-workflows.mjs

# Environment variables & local secrets
.env
.env.*
!.env.example
*.local

# IDE & Editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

